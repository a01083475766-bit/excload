// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum AuthProvider {
  CREDENTIALS
  GOOGLE
  KAKAO
  NAVER
  UNKNOWN
}

enum HeaderMappingStatus {
  AUTO_MATCHED
  LOW_CONFIDENCE
  UNMAPPED
  NEEDS_REVIEW
  CONFIRMED
  IGNORED
}

enum HeaderMappingMethod {
  BASE_HEADER
  DB_ALIAS
  STATIC_ALIAS
  AI
  REFINED
  UNMAPPED
}

enum HeaderSampleValueType {
  DATE
  MONEY
  PHONE
  ADDRESS
  NAME
  MESSAGE
  CODE
  STATUS
  TEXT
  EMPTY
}

enum HeaderMappingAdminStatus {
  PENDING
  CONFIRMED
  CHANGED
  IGNORED
  HOLD
}

model User {
  id                String       @id @default(cuid())
  email             String       @unique
  /// 이메일 찾기·1인 1번호. DB에는 하이픈 제외 숫자만 저장.
  phone             String?      @unique
  passwordHash      String? // 비밀번호 해시 (회원가입 시 저장)
  name              String?
  emailVerified     DateTime?
  image             String?
  signupProvider    AuthProvider @default(CREDENTIALS)
  lastLoginProvider AuthProvider @default(CREDENTIALS)
  createdAt         DateTime     @default(now())
  updatedAt         DateTime     @updatedAt

  /// 플랜: BETA | FREE | PRO | YEARLY (문자열. 신규 가입은 open-beta-policy 참고)
  plan               String    @default("FREE")
  /// 다음 결제일부터 적용할 예약 플랜 (PRO | YEARLY)
  pendingPlan        String?
  pendingPlanApplyAt DateTime?
  points             Int       @default(5000)
  nextPointDate      DateTime?

  deviceId   String? // 디바이스 기준 무료 혜택 제한용 식별자
  lastIp     String?
  abuseScore Int     @default(0)
  abuseFlag  Boolean @default(false)

  isBlocked   Boolean @default(false) // 계정 차단 여부
  blockReason String? // 차단 이유
  abuseReason String? // 어뷰즈 점수 사유 (요약)

  stripeCustomerId   String? @unique
  cancelAtPeriodEnd  Boolean @default(false)
  signupBonusClaimed Boolean @default(false)

  /// 토스 자동결제(빌링) — customerKey는 항상 user.id 와 동일하게 사용
  tossBillingKey     String?
  tossCardCompany    String?
  tossCardNumberMask String?

  /// 토스 결제 API 동시 호출 방지(만료 시각까지 재진입 차단). 처리 종료 시 null 로 해제.
  tossChargeCooldownUntil DateTime?

  /// 정기결제 상태: active | past_due(유예) | canceled
  subscriptionStatus   String    @default("active")
  paymentFailedAt      DateTime?
  paymentFailureReason String?
  paymentRetryCount    Int       @default(0)
  gracePeriodUntil     DateTime?

  /// 회원 탈퇴(유예) 시각. null 이면 활성 계정.
  deletedAt DateTime?
  /// 영구 삭제 예정 시각 (탈퇴 후 7일 등). purgeAt 경과 시 cron 이 hard delete.
  purgeAt   DateTime?

  /// 오픈 피드백 이벤트 PRO 체험 (유료 plan 과 분리)
  feedbackTrialEndsAt DateTime?
  feedbackTrialUsed   Boolean   @default(false)
  feedbackPopupSeenAt DateTime?

  /// 관리자 수동 PRO 혜택 (plan=FREE 유지, 만료 시 PRO 권한만 종료)
  adminTrialEndsAt DateTime?

  pointHistory                 PointHistory[]
  subscriptions                Subscription[]
  favoriteMalls                UserFavoriteMall[]
  feedbackSubmissions          FeedbackSubmission[]
  feedbackComments             FeedbackComment[]
  templateHeaderLogs           TemplateHeaderLog[]
  headerMappingAuditLogs       HeaderMappingAuditLog[]
  orderIntegrationAccounts     OrderIntegrationAccount[]
  orderSyncBatches             OrderSyncBatch[]
  orderSyncOrders              OrderSyncOrder[]
  shipmentUploadBatches        ShipmentUploadBatch[]
  shipmentUploadRows           ShipmentUploadRow[]
  shipmentMatches              ShipmentMatch[]
  shipmentTransmissionAttempts ShipmentTransmissionAttempt[]
  courierDownloadBundles       CourierDownloadBundle[]
  courierDownloadWorkItems     CourierDownloadWorkItem[]
}

enum OrderIntegrationProvider {
  COUPANG
  ELEVEN
  SMARTSTORE
  CAFE24
  LOTTEON
  SSG
  CJONSTYLE
  SHOPBY
  GODOMALL
  MAKESHOP
  SHOPIFY
  DOMEGGOOK
}

enum OrderIntegrationAccountStatus {
  ACTIVE
  INACTIVE
  ERROR
}

enum OrderSyncBatchSourceType {
  API
  EXCEL
  MANUAL
}

/// 택배양식 다운로드 WorkItem 전용 출처 (OrderSyncBatchSourceType과 분리)
enum CourierDownloadWorkItemSource {
  API
  EXCEL
  TEXT
}

enum OrderSyncBatchStatus {
  ACTIVE
  ARCHIVED
  ERROR
}

enum OrderSyncTransmissionStatus {
  NONE
  READY
  /// Match가 실행 lease를 확보하고 전송 절차 진행 중
  PROCESSING
  SENT
  FAILED
  SKIPPED
  /// 외부 API 결과를 확정할 수 없어 reconciliation 필요
  UNKNOWN
}

enum ShipmentTransmissionAttemptStatus {
  /// DB 실행권·Attempt 생성됨, 외부 API 호출 시작 전
  PENDING
  /// 외부 API 호출 직전 또는 호출 시작됨
  PROCESSING
  SUCCESS
  FAILED
  UNKNOWN
  CANCELLED
}

enum ShipmentUploadBatchStatus {
  UPLOADED
  PARSED
  MATCHED
  PARTIALLY_CONFIRMED
  CONFIRMED
  READY
  CANCELLED
}

enum ShipmentAlgorithmMatchStatus {
  MATCHED_CONFIDENT
  MATCHED_WARNING
  MULTIPLE_CANDIDATES
  NOT_MATCHED
  DUPLICATE_TRACKING_NUMBER
  ALREADY_SHIPPED
  CANCELLED_OR_INVALID_ORDER
}

enum ShipmentUserConfirmationStatus {
  UNCONFIRMED
  CONFIRMED
  MANUALLY_LINKED
  EDITED
  EXCLUDED
}

model OrderIntegrationAccount {
  id          String                   @id @default(cuid())
  userId      String
  provider    OrderIntegrationProvider
  accountName String

  /// 쿠팡 업체코드 (vendorId)
  vendorId String?
  /// 11번가 판매자 ID
  sellerId String?

  accessKeyCiphertext String? @db.Text
  accessKeyIv         String?
  accessKeyAuthTag    String?

  secretKeyCiphertext String? @db.Text
  secretKeyIv         String?
  secretKeyAuthTag    String?

  apiKeyCiphertext String? @db.Text
  apiKeyIv         String?
  apiKeyAuthTag    String?

  encryptionKeyVersion Int @default(1)

  expiresAt        DateTime?
  status           OrderIntegrationAccountStatus @default(INACTIVE)
  lastTestedAt     DateTime?
  lastSyncedAt     DateTime?
  lastErrorMessage String?                       @db.Text

  /// 실제 외부 API 연결 상태(HealthStatus). status(계정 활성/비활성)와 별개.
  healthStatus                   String?
  lastCheckedAt                  DateTime?
  lastSuccessAt                  DateTime?
  lastFailureAt                  DateTime?
  lastErrorCategory              String?
  lastErrorCode                  String?
  consecutiveFailureCount        Int       @default(0)
  /// 연결 상태 작업 시작 순번. 계정 단위 최신 결과 판정에 사용한다.
  healthOperationSequence        BigInt    @default(0)
  /// 실제 반영을 마친 마지막 연결 상태 작업 순번.
  healthAppliedOperationSequence BigInt    @default(0)
  /// 다중 인스턴스 연결 확인 중복 호출을 막는 DB lease.
  healthCheckLeaseToken          String?
  healthCheckLeaseUntil          DateTime?
  /// 네이버 커머스API센터 등에 표시된 "인증기간"을 사용자가 직접 등록하는 값(선택).
  /// 자동 조회 값이 아니며, 토큰/키 만료(expiresAt)와 혼용 금지.
  /// 시간대 변환으로 날짜가 밀리지 않도록 시간 없는 DATE(@db.Date)로 저장한다.
  authorizationPeriodStart       DateTime? @db.Date
  authorizationPeriodEnd         DateTime? @db.Date
  /// 도매꾹 발송정보(setOrdOkDeli) 세금계산서 포함 여부. 0=미포함, 1=포함, null=미선택(비밀 아님).
  /// DB 미적용 상태로 둘 수 있음 — migration만 추가.
  domeggookDeliWithTax           Int?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user                         User                          @relation(fields: [userId], references: [id], onDelete: Cascade)
  orderSyncBatches             OrderSyncBatch[]
  orderSyncOrders              OrderSyncOrder[]
  shipmentUploadBatches        ShipmentUploadBatch[]
  shipmentMatches              ShipmentMatch[]
  shipmentTransmissionAttempts ShipmentTransmissionAttempt[]

  @@unique([userId, provider, vendorId])
  @@index([userId, provider])
}

model OrderSyncBatch {
  id                   String                   @id @default(cuid())
  userId               String
  provider             OrderIntegrationProvider
  integrationAccountId String?
  sourceType           OrderSyncBatchSourceType @default(API)
  fetchedAt            DateTime                 @default(now())
  orderCount           Int                      @default(0)
  status               OrderSyncBatchStatus     @default(ACTIVE)
  memo                 String?                  @db.Text
  errorMessage         String?                  @db.Text
  createdAt            DateTime                 @default(now())
  updatedAt            DateTime                 @updatedAt

  user               User                     @relation(fields: [userId], references: [id], onDelete: Cascade)
  integrationAccount OrderIntegrationAccount? @relation(fields: [integrationAccountId], references: [id], onDelete: SetNull)
  orders             OrderSyncOrder[]

  @@index([userId, provider])
  @@index([integrationAccountId])
  @@index([fetchedAt])
}

model OrderSyncOrder {
  id                    String                      @id @default(cuid())
  batchId               String
  userId                String
  provider              OrderIntegrationProvider
  integrationAccountId  String?
  excloadOrderNo        String
  mallOrderNo           String
  mallOrderId           String?
  mallLineItemIds       Json?
  receiverName          String?
  receiverPhone         String?
  receiverAddress       String?                     @db.Text
  productSummary        String?                     @db.Text
  quantity              Int?
  /// 스마트스토어 주문조회·저장 시점 remainQuantity. 다른 몰은 null. 불명확 시 null(1 추정 금지).
  remainQuantity        Int?
  deliveryMemo          String?                     @db.Text
  orderedAt             DateTime?
  orderStatus           String?
  rawPayloadJson        Json?
  normalizedPayloadJson Json?
  trackingNumber        String?
  carrierCode           String?
  shippedAt             DateTime?
  transmissionStatus    OrderSyncTransmissionStatus @default(NONE)
  /// 택배양식 다운로드 성공 시각 (송장 매칭용 보관 기산의 기준)
  lastCourierDownloadAt DateTime?
  /// 스냅샷 만료 시각 — 이후 hard delete 대상 (다운로드+14일, 재다운로드 시 갱신)
  expiresAt             DateTime?
  /// 수취인 PII 삭제 시각 (전송 성공 직후 또는 cron 보완)
  piiClearedAt          DateTime?
  createdAt             DateTime                    @default(now())
  updatedAt             DateTime                    @updatedAt

  batch                        OrderSyncBatch                @relation(fields: [batchId], references: [id], onDelete: Cascade)
  user                         User                          @relation(fields: [userId], references: [id], onDelete: Cascade)
  integrationAccount           OrderIntegrationAccount?      @relation(fields: [integrationAccountId], references: [id], onDelete: SetNull)
  shipmentMatches              ShipmentMatch[]
  shipmentTransmissionAttempts ShipmentTransmissionAttempt[]
  courierDownloadWorkItems     CourierDownloadWorkItem[]

  @@unique([userId, excloadOrderNo])
  @@index([userId, provider])
  @@index([userId, provider, mallOrderNo])
  @@index([batchId])
  @@index([integrationAccountId])
  @@index([expiresAt])
  @@index([transmissionStatus, piiClearedAt])
}

model ExcloadOrderNoSequence {
  id         String   @id @default(cuid())
  dateKey    String
  lastNumber Int      @default(0)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@unique([dateKey])
}

model ShipmentUploadBatch {
  id                           String                    @id @default(cuid())
  userId                       String
  provider                     OrderIntegrationProvider?
  integrationAccountId         String?
  /// 사용자가 확정한 택배양식 다운로드 Bundle (없으면 null = 해당 다운로드 없음)
  downloadBundleId             String?
  originalFileName             String
  fileHash                     String?
  fileSize                     Int
  fileType                     String?
  rowCount                     Int                       @default(0)
  matchedConfidentCount        Int                       @default(0)
  matchedWarningCount          Int                       @default(0)
  multipleCandidatesCount      Int                       @default(0)
  notMatchedCount              Int                       @default(0)
  duplicateTrackingNumberCount Int                       @default(0)
  alreadyShippedCount          Int                       @default(0)
  cancelledOrInvalidOrderCount Int                       @default(0)
  status                       ShipmentUploadBatchStatus @default(UPLOADED)
  createdAt                    DateTime                  @default(now())
  updatedAt                    DateTime                  @updatedAt

  user               User                     @relation(fields: [userId], references: [id], onDelete: Cascade)
  integrationAccount OrderIntegrationAccount? @relation(fields: [integrationAccountId], references: [id], onDelete: SetNull)
  downloadBundle     CourierDownloadBundle?   @relation(fields: [downloadBundleId], references: [id], onDelete: SetNull)
  rows               ShipmentUploadRow[]
  matches            ShipmentMatch[]

  @@index([userId, createdAt])
  @@index([userId, provider])
  @@index([integrationAccountId])
  @@index([downloadBundleId])
}

/// 택배양식 다운로드 1회 묶음 (미리보기 저장 금지 — 다운로드 응답 성공 시에만 생성)
model CourierDownloadBundle {
  id                   String   @id @default(cuid())
  userId               String
  courierTemplateLabel String?
  rowCount             Int      @default(0)
  apiCount             Int      @default(0)
  manualCount          Int      @default(0)
  expiresAt            DateTime
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  user                  User                      @relation(fields: [userId], references: [id], onDelete: Cascade)
  workItems             CourierDownloadWorkItem[]
  shipmentUploadBatches ShipmentUploadBatch[]

  @@index([userId, createdAt])
  @@index([userId, expiresAt])
  @@index([expiresAt])
}

/// 다운로드 행 최소 명세 (수취인 PII·원본 JSON 저장 금지)
model CourierDownloadWorkItem {
  id                   String                        @id @default(cuid())
  userId               String
  downloadBundleId     String
  excloadOrderNo       String
  inputSource          CourierDownloadWorkItemSource
  sourceMallKey        String?
  sourceMallLabel      String?
  mallOrderNo          String?
  orderSyncOrderId     String?
  /// 선택: 정규화 값 HMAC (1차 미사용 가능)
  matchFingerprintHmac String?
  expiresAt            DateTime
  createdAt            DateTime                      @default(now())
  updatedAt            DateTime                      @updatedAt

  user           User                  @relation(fields: [userId], references: [id], onDelete: Cascade)
  downloadBundle CourierDownloadBundle @relation(fields: [downloadBundleId], references: [id], onDelete: Cascade)
  orderSyncOrder OrderSyncOrder?       @relation(fields: [orderSyncOrderId], references: [id], onDelete: SetNull)

  @@unique([userId, excloadOrderNo])
  @@index([downloadBundleId])
  @@index([userId, expiresAt])
  @@index([downloadBundleId, sourceMallKey, mallOrderNo])
  @@index([orderSyncOrderId])
  @@index([expiresAt])
}

model ShipmentUploadRow {
  id                       String   @id @default(cuid())
  uploadBatchId            String
  userId                   String
  originalRowIndex         Int
  /// 원본 행 JSON — 업로드+14일 독립 scrub 시 DB NULL
  rawRowJson               Json?
  trackingNumber           String
  trackingNumberNormalized String
  carrierName              String?
  carrierCode              String?
  receiverName             String?
  receiverPhone            String?
  receiverPhoneNormalized  String?
  receiverAddress          String?  @db.Text
  mallOrderNo              String?
  excloadOrderNo           String?
  productText              String?
  warningsJson             Json?
  createdAt                DateTime @default(now())
  updatedAt                DateTime @updatedAt

  uploadBatch ShipmentUploadBatch @relation(fields: [uploadBatchId], references: [id], onDelete: Cascade)
  user        User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  match       ShipmentMatch?

  @@unique([uploadBatchId, originalRowIndex])
  @@index([uploadBatchId])
  @@index([userId])
  @@index([trackingNumberNormalized])
  @@index([excloadOrderNo])
  @@index([mallOrderNo])
  @@index([createdAt])
}

model ShipmentMatch {
  id                         String                         @id @default(cuid())
  uploadBatchId              String
  uploadRowId                String                         @unique
  userId                     String
  orderSyncOrderId           String?
  provider                   OrderIntegrationProvider?
  integrationAccountId       String?
  algorithmMatchStatus       ShipmentAlgorithmMatchStatus
  userConfirmationStatus     ShipmentUserConfirmationStatus @default(UNCONFIRMED)
  /// OrderSyncTransmissionStatus.NONE = 앱 레이어 NOT_READY
  transmissionStatus         OrderSyncTransmissionStatus    @default(NONE)
  matchScore                 Int                            @default(0)
  matchReason                String?                        @db.Text
  mismatchFieldsJson         Json?
  candidateOrdersJson        Json?
  finalTrackingNumber        String?
  finalCarrierCode           String?
  finalCarrierName           String?
  confirmedAt                DateTime?
  confirmedByUserId          String?
  excludedAt                 DateTime?
  excludeReason              String?                        @db.Text
  transmissionErrorMessage   String?                        @db.Text
  /// 동시 실행 lease 토큰 (실행권 확보 시 설정)
  transmissionLeaseToken     String?                        @db.VarChar(64)
  transmissionLeaseExpiresAt DateTime?
  lastTransmissionAttemptAt  DateTime?
  createdAt                  DateTime                       @default(now())
  updatedAt                  DateTime                       @updatedAt

  uploadBatch          ShipmentUploadBatch           @relation(fields: [uploadBatchId], references: [id], onDelete: Cascade)
  uploadRow            ShipmentUploadRow             @relation(fields: [uploadRowId], references: [id], onDelete: Cascade)
  user                 User                          @relation(fields: [userId], references: [id], onDelete: Cascade)
  orderSyncOrder       OrderSyncOrder?               @relation(fields: [orderSyncOrderId], references: [id], onDelete: SetNull)
  integrationAccount   OrderIntegrationAccount?      @relation(fields: [integrationAccountId], references: [id], onDelete: SetNull)
  transmissionAttempts ShipmentTransmissionAttempt[]

  @@index([uploadBatchId])
  @@index([uploadRowId])
  @@index([orderSyncOrderId])
  @@index([userId, algorithmMatchStatus])
  @@index([userId, userConfirmationStatus])
  @@index([userId, transmissionStatus])
  @@index([integrationAccountId])
  @@index([transmissionStatus, transmissionLeaseExpiresAt])
  @@index([createdAt])
}

/// 송장전송 시도 이력 (Match = 논리 상태 SSOT, Attempt = 실행 이력)
model ShipmentTransmissionAttempt {
  id                   String                   @id @default(cuid())
  userId               String
  shipmentMatchId      String
  orderSyncOrderId     String?
  /// Match.uploadBatchId snapshot (별도 Batch relation 없음 — 중복 FK 방지)
  uploadBatchId        String
  provider             OrderIntegrationProvider
  integrationAccountId String?

  mallOrderNo              String
  excloadOrderNo           String
  mallLineItemIdsJson      Json?
  trackingNumberNormalized String
  courierCode              String?
  courierName              String?

  /// SHA-256 hex (v1). unique 금지 — 동일 fingerprint 재시도 허용
  payloadFingerprint  String                            @db.VarChar(64)
  fingerprintVersion  Int                               @default(1)
  attemptNo           Int
  status              ShipmentTransmissionAttemptStatus
  providerRequestId   String?
  /// ShipmentTransmissionResponseSummary 수준만 (앱에서 검증)
  responseSummaryJson Json?
  errorCode           String?
  errorMessage        String?                           @db.VarChar(500)
  retryable           Boolean                           @default(false)
  /// Match lease 토큰과 동일 — stale writer 방지
  executionToken      String                            @db.VarChar(64)

  startedAt    DateTime  @default(now())
  /// 외부 API 호출 직전 PENDING→PROCESSING 전환 시각
  dispatchedAt DateTime?
  completedAt  DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  user               User                     @relation(fields: [userId], references: [id], onDelete: Cascade)
  shipmentMatch      ShipmentMatch            @relation(fields: [shipmentMatchId], references: [id], onDelete: Cascade)
  orderSyncOrder     OrderSyncOrder?          @relation(fields: [orderSyncOrderId], references: [id], onDelete: SetNull)
  integrationAccount OrderIntegrationAccount? @relation(fields: [integrationAccountId], references: [id], onDelete: SetNull)

  @@unique([shipmentMatchId, attemptNo])
  @@index([shipmentMatchId, createdAt])
  @@index([userId, provider, createdAt])
  @@index([payloadFingerprint])
  @@index([providerRequestId])
  @@index([status, startedAt])
  @@index([uploadBatchId])
  @@index([integrationAccountId])
  @@index([orderSyncOrderId])
}

model EmailVerificationToken {
  id        String   @id @default(cuid())
  email     String
  token     String   @unique
  createdAt DateTime @default(now())
  expiresAt DateTime
}

model PasswordResetCode {
  id           String    @id @default(cuid())
  email        String
  codeHash     String
  expiresAt    DateTime
  usedAt       DateTime?
  attemptCount Int       @default(0)
  purpose      String
  createdAt    DateTime  @default(now())

  @@index([email])
  @@index([expiresAt])
}

model PasswordResetRequestLog {
  id        String   @id @default(cuid())
  ip        String
  email     String?
  createdAt DateTime @default(now())

  @@index([ip, createdAt])
  @@index([createdAt])
}

model PasswordResetAuditLog {
  id        String   @id @default(cuid())
  email     String
  ip        String?
  action    String
  status    String
  reason    String?
  createdAt DateTime @default(now())

  @@index([email, createdAt])
  @@index([ip, createdAt])
  @@index([createdAt])
}

model SignupVerification {
  id           String    @id @default(cuid())
  email        String    @unique
  phone        String
  passwordHash String
  plan         String    @default("FREE")
  deviceId     String?
  codeHash     String
  expiresAt    DateTime
  usedAt       DateTime?
  attemptCount Int       @default(0)
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  @@index([expiresAt])
}

model PointHistory {
  id        String   @id @default(cuid())
  userId    String
  change    Int
  reason    String
  createdAt DateTime @default(now())

  /// Stripe Checkout Session ID (cs_…)
  stripeSessionId String?
  /// Stripe Invoice ID (in_…)
  stripeInvoiceId String?

  user User @relation(fields: [userId], references: [id])
}

model RefundRequest {
  id            String    @id @default(cuid())
  userId        String
  paymentId     String?
  type          String // AUTO_CANCEL | REFUND
  status        String // REQUESTED | APPROVED | REJECTED | COMPLETED
  bankName      String?
  accountNumber String?
  accountHolder String?
  reason        String?
  createdAt     DateTime  @default(now())
  processedAt   DateTime?
}

/// 고객문의 (/contact) 접수 내역
model ContactInquiry {
  id             String    @id @default(cuid())
  type           String
  typeLabel      String
  name           String
  email          String
  subject        String
  message        String    @db.Text
  company        String?
  phone          String?
  attachmentName String?
  /// NEW | IN_PROGRESS | RESOLVED
  status         String    @default("NEW")
  mailSent       Boolean   @default(false)
  adminNote      String?   @db.Text
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  processedAt    DateTime?

  @@index([createdAt])
  @@index([status])
}

model Payment {
  id       String @id @default(cuid())
  userId   String
  email    String
  plan     String
  amount   Int // 결제 금액 (원 단위)
  currency String @default("KRW")

  stripeSessionId      String? @unique
  stripeSubscriptionId String?
  stripeInvoiceId      String?

  paymentProvider String? // STRIPE | TOSS
  tossPaymentKey  String?
  tossOrderId     String?

  createdAt DateTime @default(now())
}

model AiHeaderMappingLog {
  id             String   @id @default(cuid())
  originalHeader String
  aiMappedHeader String
  baseHeader     String
  sourceType     String
  createdAt      DateTime @default(now())
}

model HeaderAlias {
  id         String   @id @default(cuid())
  alias      String   @unique
  baseHeader String
  source     String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
}

/// 택배·물류·송장 업로드 양식 등록 시 엑셀 1행 헤더만 수집 (주문 데이터·PII 미저장)
model TemplateHeaderLog {
  id                 String   @id @default(cuid())
  userId             String?
  fileSessionId      String?
  templateId         String?
  page               String
  templateName       String?
  courierName        String?
  headers            Json
  mappedHeaders      Json
  unknownHeaders     Json
  headerCount        Int
  mappingSuccessRate Float?
  source             String   @default("template_upload")
  createdAt          DateTime @default(now())

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([createdAt])
  @@index([page])
  @@index([courierName])
  @@index([userId])
}

/// 업로드에서 처음 발견된 헤더명 사전 (중복 헤더는 1회만 등록)
model HeaderDictionary {
  id                String   @id @default(cuid())
  header            String   @unique
  firstSeenAt       DateTime @default(now())
  page              String
  source            String
  exampleBaseHeader String?

  usage HeaderUsageCount?

  @@index([firstSeenAt])
  @@index([page])
  @@index([source])
}

/// 헤더별 업로드 등장(사용) 횟수
model HeaderUsageCount {
  id                 String   @id @default(cuid())
  headerDictionaryId String   @unique
  count              Int      @default(1)
  lastSeenAt         DateTime @default(now())
  updatedAt          DateTime @default(now()) @updatedAt

  dictionary HeaderDictionary @relation(fields: [headerDictionaryId], references: [id], onDelete: Cascade)

  @@index([count])
  @@index([lastSeenAt])
}

/// 헤더 매핑 감사 로그 — 업로드/변환 1건 단위. 원본 파일·전체 행 데이터는 저장하지 않음.
model HeaderMappingAuditLog {
  id                            String    @id @default(cuid())
  userId                        String?
  fileHash                      String?
  source                        String?
  totalHeaders                  Int
  autoMatchedCount              Int
  unmappedCount                 Int
  lowConfidenceCount            Int
  needsReviewCount              Int
  entriesWithMaskedSamplesCount Int
  createdAt                     DateTime  @default(now())
  expiresAt                     DateTime?

  user    User?                     @relation(fields: [userId], references: [id], onDelete: SetNull)
  entries HeaderMappingAuditEntry[]

  @@index([createdAt])
  @@index([expiresAt])
  @@index([fileHash])
  @@index([source])
  @@index([userId])
}

/// 원본 헤더 1개 단위 감사 엔트리. 샘플은 마스킹된 값만 JSON으로 저장 가능.
model HeaderMappingAuditEntry {
  id                      String                   @id @default(cuid())
  auditLogId              String
  originalHeader          String
  baseHeader              String?
  status                  HeaderMappingStatus
  method                  HeaderMappingMethod
  confidenceReason        String?
  sampleValueType         HeaderSampleValueType
  maskedSamples           Json
  sampleCount             Int
  hasMaskedSamples        Boolean
  adminStatus             HeaderMappingAdminStatus @default(PENDING)
  adminSelectedBaseHeader String?
  adminSelectedAt         DateTime?
  adminMemo               String?
  reviewedAt              DateTime?
  createdAt               DateTime                 @default(now())

  auditLog HeaderMappingAuditLog @relation(fields: [auditLogId], references: [id], onDelete: Cascade)

  @@index([auditLogId])
  @@index([originalHeader])
  @@index([baseHeader])
  @@index([status])
  @@index([method])
  @@index([sampleValueType])
  @@index([adminStatus])
  @@index([createdAt])
}

model StripeEvent {
  id        String   @id @default(cuid())
  eventId   String   @unique
  createdAt DateTime @default(now())
}

model Subscription {
  id                   String @id @default(cuid())
  userId               String
  stripeCustomerId     String
  stripeSubscriptionId String @unique

  status            String
  cancelAtPeriodEnd Boolean @default(false)

  currentPeriodStart DateTime?
  currentPeriodEnd   DateTime?

  paymentProvider String? // STRIPE | TOSS
  tossBillingKey  String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id])
}

/// 오픈 피드백 이벤트 기간·활성 (id=default 단일 행)
model FeedbackEventSettings {
  id        String   @id @default("default")
  endsAt    DateTime
  isEnabled Boolean  @default(true)
  updatedAt DateTime @updatedAt
}

/// 피드백 이벤트 제출 (체험권은 계정당 1회, 제출 시 자동 부여)
model FeedbackSubmission {
  id               String   @id @default(cuid())
  userId           String
  featureUsed      String
  conversionResult String
  content          String   @db.Text
  publicConsent    Boolean  @default(false)
  attachmentName   String?
  attachmentUrl    String?
  trialGranted     Boolean  @default(false)
  systemReply      String?  @db.Text
  createdAt        DateTime @default(now())

  user     User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  comments FeedbackComment[]

  @@index([userId, createdAt])
  @@index([publicConsent, createdAt])
}

model FeedbackComment {
  id             String   @id @default(cuid())
  submissionId   String
  userId         String
  content        String   @db.Text
  isAdminComment Boolean  @default(false)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  submission FeedbackSubmission @relation(fields: [submissionId], references: [id], onDelete: Cascade)
  user       User               @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([submissionId, createdAt])
  @@index([submissionId, isAdminComment, createdAt])
  @@index([userId, createdAt])
}

model PopupCampaign {
  id             String   @id @default(cuid())
  title          String
  imageUrl       String
  linkUrl        String?
  startAt        DateTime
  endAt          DateTime
  isActive       Boolean  @default(true)
  priority       Int      @default(0)
  target         String   @default("ALL") // ALL | ORDER_CONVERT | HISTORY | OTHER
  showEveryVisit Boolean  @default(true) // true: 이동할 때마다, false: 해당 페이지에서 한 번만
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
}

/// 체험판(/trial) IP별 접속 횟수 (해시만 저장)
model TrialIpAccess {
  id        String   @id @default(cuid())
  ipHash    String   @unique
  count     Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

/// 계정별 즐겨찾는 쇼핑몰 바로가기
model UserFavoriteMall {
  id        String   @id @default(cuid())
  userId    String
  name      String   @default("")
  url       String   @default("")
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, sortOrder])
}

/// URL별 등록 집계 (관리자·기본값 제공용)
model FavoriteMallUrlStat {
  id              String   @id @default(cuid())
  normalizedUrl   String   @unique
  registerCount   Int      @default(0)
  uniqueUserCount Int      @default(0)
  updatedAt       DateTime @updatedAt

  @@index([uniqueUserCount])
}

/// 사용자가 특정 URL을 한 번이라도 저장했는지 (uniqueUserCount 집계용)
model UserFavoriteMallUrlSeen {
  userId        String
  normalizedUrl String
  createdAt     DateTime @default(now())

  @@id([userId, normalizedUrl])
}

/// 무료 혜택(가입·월간) 재수령 방지 — 탈퇴 후에도 해시만 보관
model FreeBenefitFingerprint {
  type                 String
  hash                 String
  signupBonusUsed      Boolean   @default(false)
  blockedAfterWithdraw Boolean   @default(false)
  firstClaimedAt       DateTime  @default(now())
  lastWithdrawnAt      DateTime?
  withdrawCount        Int       @default(0)

  @@id([type, hash])
  @@index([blockedAfterWithdraw])
}

/// 커머스 리포트/뉴스레터 — 관리 키워드 (관리자 전용, 파이프라인 구조와 무관)
model CommerceKeyword {
  id        String   @id @default(cuid())
  keyword   String
  category  String?
  isActive  Boolean  @default(true)
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([keyword])
  @@index([isActive, sortOrder])
}

/// 커머스 리포트/뉴스레터 설정 — 싱글턴 1행(id="default")
model CommerceReportSettings {
  id          String   @id @default("default")
  /// 금지 표현 목록 (문자열 배열 JSON)
  bannedWords Json
  adPhrase    String   @default("")
  /// PLAIN | FRIENDLY | PROFESSIONAL
  toneStyle   String   @default("PLAIN")
  updatedAt   DateTime @updatedAt
}
