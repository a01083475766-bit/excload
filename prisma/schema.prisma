// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum AuthProvider {
  CREDENTIALS
  GOOGLE
  KAKAO
  NAVER
  UNKNOWN
}

enum HeaderMappingStatus {
  AUTO_MATCHED
  LOW_CONFIDENCE
  UNMAPPED
  NEEDS_REVIEW
  CONFIRMED
  IGNORED
}

enum HeaderMappingMethod {
  BASE_HEADER
  DB_ALIAS
  STATIC_ALIAS
  AI
  REFINED
  UNMAPPED
}

enum HeaderSampleValueType {
  DATE
  MONEY
  PHONE
  ADDRESS
  NAME
  MESSAGE
  CODE
  STATUS
  TEXT
  EMPTY
}

enum HeaderMappingAdminStatus {
  PENDING
  CONFIRMED
  CHANGED
  IGNORED
  HOLD
}

model User {
  id                String       @id @default(cuid())
  email             String       @unique
  /// 이메일 찾기·1인 1번호. DB에는 하이픈 제외 숫자만 저장.
  phone             String?      @unique
  passwordHash      String? // 비밀번호 해시 (회원가입 시 저장)
  name              String?
  emailVerified     DateTime?
  image             String?
  signupProvider    AuthProvider @default(CREDENTIALS)
  lastLoginProvider AuthProvider @default(CREDENTIALS)
  createdAt         DateTime     @default(now())
  updatedAt         DateTime     @updatedAt

  plan               String    @default("FREE")
  /// 다음 결제일부터 적용할 예약 플랜 (PRO | YEARLY)
  pendingPlan        String?
  pendingPlanApplyAt DateTime?
  points             Int       @default(5000)
  nextPointDate      DateTime?

  deviceId   String? // 디바이스 기준 무료 혜택 제한용 식별자
  lastIp     String?
  abuseScore Int     @default(0)
  abuseFlag  Boolean @default(false)

  isBlocked   Boolean @default(false) // 계정 차단 여부
  blockReason String? // 차단 이유
  abuseReason String? // 어뷰즈 점수 사유 (요약)

  stripeCustomerId   String? @unique
  cancelAtPeriodEnd  Boolean @default(false)
  signupBonusClaimed Boolean @default(false)

  /// 토스 자동결제(빌링) — customerKey는 항상 user.id 와 동일하게 사용
  tossBillingKey     String?
  tossCardCompany    String?
  tossCardNumberMask String?

  /// 토스 결제 API 동시 호출 방지(만료 시각까지 재진입 차단). 처리 종료 시 null 로 해제.
  tossChargeCooldownUntil DateTime?

  /// 정기결제 상태: active | past_due(유예) | canceled
  subscriptionStatus   String    @default("active")
  paymentFailedAt      DateTime?
  paymentFailureReason String?
  paymentRetryCount    Int       @default(0)
  gracePeriodUntil     DateTime?

  /// 회원 탈퇴(유예) 시각. null 이면 활성 계정.
  deletedAt DateTime?
  /// 영구 삭제 예정 시각 (탈퇴 후 7일 등). purgeAt 경과 시 cron 이 hard delete.
  purgeAt   DateTime?

  /// 오픈 피드백 이벤트 PRO 체험 (유료 plan 과 분리)
  feedbackTrialEndsAt DateTime?
  feedbackTrialUsed   Boolean   @default(false)
  feedbackPopupSeenAt DateTime?

  /// 관리자 수동 PRO 혜택 (plan=FREE 유지, 만료 시 PRO 권한만 종료)
  adminTrialEndsAt DateTime?

  pointHistory           PointHistory[]
  subscriptions          Subscription[]
  favoriteMalls          UserFavoriteMall[]
  feedbackSubmissions    FeedbackSubmission[]
  templateHeaderLogs     TemplateHeaderLog[]
  headerMappingAuditLogs HeaderMappingAuditLog[]
  orderIntegrationAccounts OrderIntegrationAccount[]
}

enum OrderIntegrationProvider {
  COUPANG
  ELEVEN
  SMARTSTORE
  CAFE24
  LOTTEON
  SSG
}

enum OrderIntegrationAccountStatus {
  ACTIVE
  INACTIVE
  ERROR
}

model OrderIntegrationAccount {
  id          String                      @id @default(cuid())
  userId      String
  provider    OrderIntegrationProvider
  accountName String

  /// 쿠팡 업체코드 (vendorId)
  vendorId String?
  /// 11번가 판매자 ID
  sellerId String?

  accessKeyCiphertext String? @db.Text
  accessKeyIv         String?
  accessKeyAuthTag    String?

  secretKeyCiphertext String? @db.Text
  secretKeyIv         String?
  secretKeyAuthTag    String?

  apiKeyCiphertext String? @db.Text
  apiKeyIv         String?
  apiKeyAuthTag    String?

  encryptionKeyVersion Int @default(1)

  expiresAt        DateTime?
  status           OrderIntegrationAccountStatus @default(INACTIVE)
  lastTestedAt     DateTime?
  lastSyncedAt     DateTime?
  lastErrorMessage String?                       @db.Text

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, provider, vendorId])
  @@index([userId, provider])
}

model EmailVerificationToken {
  id        String   @id @default(cuid())
  email     String
  token     String   @unique
  createdAt DateTime @default(now())
  expiresAt DateTime
}

model PasswordResetCode {
  id           String    @id @default(cuid())
  email        String
  codeHash     String
  expiresAt    DateTime
  usedAt       DateTime?
  attemptCount Int       @default(0)
  purpose      String
  createdAt    DateTime  @default(now())

  @@index([email])
  @@index([expiresAt])
}

model PasswordResetRequestLog {
  id        String   @id @default(cuid())
  ip        String
  email     String?
  createdAt DateTime @default(now())

  @@index([ip, createdAt])
  @@index([createdAt])
}

model PasswordResetAuditLog {
  id        String   @id @default(cuid())
  email     String
  ip        String?
  action    String
  status    String
  reason    String?
  createdAt DateTime @default(now())

  @@index([email, createdAt])
  @@index([ip, createdAt])
  @@index([createdAt])
}

model SignupVerification {
  id           String    @id @default(cuid())
  email        String    @unique
  phone        String
  passwordHash String
  plan         String    @default("FREE")
  deviceId     String?
  codeHash     String
  expiresAt    DateTime
  usedAt       DateTime?
  attemptCount Int       @default(0)
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  @@index([expiresAt])
}

model PointHistory {
  id        String   @id @default(cuid())
  userId    String
  change    Int
  reason    String
  createdAt DateTime @default(now())

  /// Stripe Checkout Session ID (cs_…)
  stripeSessionId String?
  /// Stripe Invoice ID (in_…)
  stripeInvoiceId String?

  user User @relation(fields: [userId], references: [id])
}

model RefundRequest {
  id            String    @id @default(cuid())
  userId        String
  paymentId     String?
  type          String // AUTO_CANCEL | REFUND
  status        String // REQUESTED | APPROVED | REJECTED | COMPLETED
  bankName      String?
  accountNumber String?
  accountHolder String?
  reason        String?
  createdAt     DateTime  @default(now())
  processedAt   DateTime?
}

/// 고객문의 (/contact) 접수 내역
model ContactInquiry {
  id             String    @id @default(cuid())
  type           String
  typeLabel      String
  name           String
  email          String
  subject        String
  message        String    @db.Text
  company        String?
  phone          String?
  attachmentName String?
  /// NEW | IN_PROGRESS | RESOLVED
  status         String    @default("NEW")
  mailSent       Boolean   @default(false)
  adminNote      String?   @db.Text
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  processedAt    DateTime?

  @@index([createdAt])
  @@index([status])
}

model Payment {
  id       String @id @default(cuid())
  userId   String
  email    String
  plan     String
  amount   Int // 결제 금액 (원 단위)
  currency String @default("KRW")

  stripeSessionId      String? @unique
  stripeSubscriptionId String?
  stripeInvoiceId      String?

  paymentProvider String? // STRIPE | TOSS
  tossPaymentKey  String?
  tossOrderId     String?

  createdAt DateTime @default(now())
}

model AiHeaderMappingLog {
  id             String   @id @default(cuid())
  originalHeader String
  aiMappedHeader String
  baseHeader     String
  sourceType     String
  createdAt      DateTime @default(now())
}

model HeaderAlias {
  id         String   @id @default(cuid())
  alias      String   @unique
  baseHeader String
  source     String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
}

/// 택배·물류·송장 업로드 양식 등록 시 엑셀 1행 헤더만 수집 (주문 데이터·PII 미저장)
model TemplateHeaderLog {
  id                 String   @id @default(cuid())
  userId             String?
  fileSessionId      String?
  templateId         String?
  page               String
  templateName       String?
  courierName        String?
  headers            Json
  mappedHeaders      Json
  unknownHeaders     Json
  headerCount        Int
  mappingSuccessRate Float?
  source             String   @default("template_upload")
  createdAt          DateTime @default(now())

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([createdAt])
  @@index([page])
  @@index([courierName])
  @@index([userId])
}

/// 업로드에서 처음 발견된 헤더명 사전 (중복 헤더는 1회만 등록)
model HeaderDictionary {
  id                String   @id @default(cuid())
  header            String   @unique
  firstSeenAt       DateTime @default(now())
  page              String
  source            String
  exampleBaseHeader String?

  usage HeaderUsageCount?

  @@index([firstSeenAt])
  @@index([page])
  @@index([source])
}

/// 헤더별 업로드 등장(사용) 횟수
model HeaderUsageCount {
  id                 String   @id @default(cuid())
  headerDictionaryId String   @unique
  count              Int      @default(1)
  lastSeenAt         DateTime @default(now())
  updatedAt          DateTime @default(now()) @updatedAt

  dictionary HeaderDictionary @relation(fields: [headerDictionaryId], references: [id], onDelete: Cascade)

  @@index([count])
  @@index([lastSeenAt])
}

/// 헤더 매핑 감사 로그 — 업로드/변환 1건 단위. 원본 파일·전체 행 데이터는 저장하지 않음.
model HeaderMappingAuditLog {
  id                            String    @id @default(cuid())
  userId                        String?
  fileHash                      String?
  source                        String?
  totalHeaders                  Int
  autoMatchedCount              Int
  unmappedCount                 Int
  lowConfidenceCount            Int
  needsReviewCount              Int
  entriesWithMaskedSamplesCount Int
  createdAt                     DateTime  @default(now())
  expiresAt                     DateTime?

  user    User?                     @relation(fields: [userId], references: [id], onDelete: SetNull)
  entries HeaderMappingAuditEntry[]

  @@index([createdAt])
  @@index([expiresAt])
  @@index([fileHash])
  @@index([source])
  @@index([userId])
}

/// 원본 헤더 1개 단위 감사 엔트리. 샘플은 마스킹된 값만 JSON으로 저장 가능.
model HeaderMappingAuditEntry {
  id                      String                   @id @default(cuid())
  auditLogId              String
  originalHeader          String
  baseHeader              String?
  status                  HeaderMappingStatus
  method                  HeaderMappingMethod
  confidenceReason        String?
  sampleValueType         HeaderSampleValueType
  maskedSamples           Json
  sampleCount             Int
  hasMaskedSamples        Boolean
  adminStatus             HeaderMappingAdminStatus @default(PENDING)
  adminSelectedBaseHeader String?
  adminSelectedAt         DateTime?
  adminMemo               String?
  reviewedAt              DateTime?
  createdAt               DateTime                 @default(now())

  auditLog HeaderMappingAuditLog @relation(fields: [auditLogId], references: [id], onDelete: Cascade)

  @@index([auditLogId])
  @@index([originalHeader])
  @@index([baseHeader])
  @@index([status])
  @@index([method])
  @@index([sampleValueType])
  @@index([adminStatus])
  @@index([createdAt])
}

model StripeEvent {
  id        String   @id @default(cuid())
  eventId   String   @unique
  createdAt DateTime @default(now())
}

model Subscription {
  id                   String @id @default(cuid())
  userId               String
  stripeCustomerId     String
  stripeSubscriptionId String @unique

  status            String
  cancelAtPeriodEnd Boolean @default(false)

  currentPeriodStart DateTime?
  currentPeriodEnd   DateTime?

  paymentProvider String? // STRIPE | TOSS
  tossBillingKey  String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id])
}

/// 오픈 피드백 이벤트 기간·활성 (id=default 단일 행)
model FeedbackEventSettings {
  id        String   @id @default("default")
  endsAt    DateTime
  isEnabled Boolean  @default(true)
  updatedAt DateTime @updatedAt
}

/// 피드백 이벤트 제출 (체험권은 계정당 1회, 제출 시 자동 부여)
model FeedbackSubmission {
  id               String   @id @default(cuid())
  userId           String
  featureUsed      String
  conversionResult String
  content          String   @db.Text
  publicConsent    Boolean  @default(false)
  attachmentName   String?
  attachmentUrl    String?
  trialGranted     Boolean  @default(false)
  systemReply      String?  @db.Text
  createdAt        DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@index([publicConsent, createdAt])
}

model PopupCampaign {
  id             String   @id @default(cuid())
  title          String
  imageUrl       String
  linkUrl        String?
  startAt        DateTime
  endAt          DateTime
  isActive       Boolean  @default(true)
  priority       Int      @default(0)
  target         String   @default("ALL") // ALL | ORDER_CONVERT | HISTORY | OTHER
  showEveryVisit Boolean  @default(true) // true: 이동할 때마다, false: 해당 페이지에서 한 번만
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
}

/// 체험판(/trial) IP별 접속 횟수 (해시만 저장)
model TrialIpAccess {
  id        String   @id @default(cuid())
  ipHash    String   @unique
  count     Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

/// 계정별 즐겨찾는 쇼핑몰 바로가기
model UserFavoriteMall {
  id        String   @id @default(cuid())
  userId    String
  name      String   @default("")
  url       String   @default("")
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, sortOrder])
}

/// URL별 등록 집계 (관리자·기본값 제공용)
model FavoriteMallUrlStat {
  id              String   @id @default(cuid())
  normalizedUrl   String   @unique
  registerCount   Int      @default(0)
  uniqueUserCount Int      @default(0)
  updatedAt       DateTime @updatedAt

  @@index([uniqueUserCount])
}

/// 사용자가 특정 URL을 한 번이라도 저장했는지 (uniqueUserCount 집계용)
model UserFavoriteMallUrlSeen {
  userId        String
  normalizedUrl String
  createdAt     DateTime @default(now())

  @@id([userId, normalizedUrl])
}

/// 무료 혜택(가입·월간) 재수령 방지 — 탈퇴 후에도 해시만 보관
model FreeBenefitFingerprint {
  type                 String
  hash                 String
  signupBonusUsed      Boolean   @default(false)
  blockedAfterWithdraw Boolean   @default(false)
  firstClaimedAt       DateTime  @default(now())
  lastWithdrawnAt      DateTime?
  withdrawCount        Int       @default(0)

  @@id([type, hash])
  @@index([blockedAfterWithdraw])
}

/// 커머스 리포트/뉴스레터 — 관리 키워드 (관리자 전용, 파이프라인 구조와 무관)
model CommerceKeyword {
  id        String   @id @default(cuid())
  keyword   String
  category  String?
  isActive  Boolean  @default(true)
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([keyword])
  @@index([isActive, sortOrder])
}

/// 커머스 리포트/뉴스레터 설정 — 싱글턴 1행(id="default")
model CommerceReportSettings {
  id          String   @id @default("default")
  /// 금지 표현 목록 (문자열 배열 JSON)
  bannedWords Json
  adPhrase    String   @default("")
  /// PLAIN | FRIENDLY | PROFESSIONAL
  toneStyle   String   @default("PLAIN")
  updatedAt   DateTime @updatedAt
}
