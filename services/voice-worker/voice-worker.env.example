# Shared secret between EXCLOAD (Vercel) and this GPU worker. Never expose as NEXT_PUBLIC_*.
VOICE_SERVICE_SECRET=change-me-to-a-long-random-string

# Official CosyVoice clone path on the GPU host
COSYVOICE_REPO_PATH=/opt/CosyVoice

# Downloaded Fun-CosyVoice3-0.5B-2512 weights directory
COSYVOICE_MODEL_PATH=/opt/CosyVoice/pretrained_models/Fun-CosyVoice3-0.5B

# Load model on process start (set 0 to lazy-load on first /generate)
VOICE_PRELOAD_MODEL=1

# Bind
HOST=0.0.0.0
PORT=8090
