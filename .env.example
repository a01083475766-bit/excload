# =============================================================================
# .env.example — 변수 이름·설명만 (값 비움). GitHub 커밋 가능.
# 실제 값은 .env / Vercel Environment Variables 에만 넣으세요.
# =============================================================================

# --- Database ---
DATABASE_URL=
DIRECT_URL=

# --- NextAuth ---
NEXTAUTH_SECRET=
# 운영: https://www.excload.com / 로컬: http://localhost:3000 (.env.local 권장)
NEXTAUTH_URL=

# --- 관리자 ---
ADMIN_EMAIL=
ADMIN_EMAILS=
NEXT_PUBLIC_ADMIN_EMAIL=

# --- OAuth ---
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
KAKAO_CLIENT_ID=
KAKAO_CLIENT_SECRET=
NAVER_CLIENT_ID=
NAVER_CLIENT_SECRET=

# --- 메일 ---
RESEND_API_KEY=
EMAIL_FROM=noreply@excload.com
PASSWORD_RESET_EMAIL_FROM=
PASSWORD_RESET_CODE_SECRET=

# --- 주문연동 암호화 / 쿠팡 프록시 ---
EXCLOAD_INTEGRATION_ENCRYPTION_KEY=
COUPANG_PROXY_BASE_URL=https://coupang-proxy.excload.com
COUPANG_PROXY_SHARED_SECRET=
INTEGRATION_PROXY_BASE_URL=
INTEGRATION_PROXY_SHARED_SECRET=
INTEGRATION_PROXY_KEY_ID=default
NEXT_PUBLIC_EXCLOAD_OUTBOUND_IP=

# --- 네이버 쇼핑 검색 API ---
NAVER_SHOPPING_CLIENT_ID=
NAVER_SHOPPING_CLIENT_SECRET=

# --- 토스페이먼츠 (서버 / 클라이언트 분리) ---
TOSS_SECRET_KEY=
NEXT_PUBLIC_TOSS_CLIENT_KEY=

# --- Stripe ---
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_MONTHLY_PRICE_ID=
STRIPE_YEARLY_PRICE_ID=

# --- AI ---
NEXT_PUBLIC_AI_ENABLED=
AI_MODEL=gpt-4.1-mini
OPENAI_API_KEY=
AI_ALLOW_ANONYMOUS_TRIAL=

# --- 기타 ---
NEXT_PUBLIC_BASE_URL=
HEADER_MAPPING_AUDIT_ENABLED=
CRON_SECRET=
WEBHOOK_INTERNAL_SECRET=
ADMIN_CREATE_SECRET=
ADMIN_BCRYPT_HASH=

# --- 주문 snapshot DB 저장 ---
# ORDER_SYNC_SNAPSHOT_PERSIST_ENABLED=false

# --- Shopify (기본 비활성) ---
# SHOPIFY_INTEGRATION_ENABLED=false
# SHOPIFY_CLIENT_ID=
# SHOPIFY_CLIENT_SECRET=
# SHOPIFY_OAUTH_STATE_SECRET=
# SHOPIFY_OAUTH_REDIRECT_URI=
# SHOPIFY_API_VERSION=2026-01

# --- 디버그 (선택) ---
# NEXTAUTH_DEBUG=true
# NEXTAUTH_DEBUG_PERF=true

# --- Open beta / Service GA (end-exclusive) ---
# Default if unset: 2026-10-01T00:00:00+09:00
# OPEN_BETA_ENDS_AT=2026-10-01T00:00:00+09:00

# --- External voucher code HMAC (min 32 characters) ---
# Required for voucher issue / redeem hashing. Set real value only in .env / Vercel.
# VOUCHER_CODE_HMAC_SECRET=
