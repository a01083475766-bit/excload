DATABASE_URL=
DIRECT_URL=
NEXTAUTH_SECRET=

# Password reset mail
RESEND_API_KEY=
EMAIL_FROM=noreply@excload.com
# Optional: if set, this value is preferred over EMAIL_FROM
PASSWORD_RESET_EMAIL_FROM=
# Optional: secret for hashing password reset code
PASSWORD_RESET_CODE_SECRET=
# 데이터베이스 (기존과 동일)
# DATABASE_URL=
# DIRECT_URL=

# NextAuth
# NEXTAUTH_SECRET=
# 운영 예: https://www.excload.com (끝 슬래시 없이, 실제 접속 도메인과 동일)
# NEXTAUTH_URL=https://your-production-domain.com
# OAuthCallback 디버깅 시에만 true → Vercel 로그 확인 후 삭제
# NEXTAUTH_DEBUG=true
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
KAKAO_CLIENT_ID=
# Kakao 로그인에서 Client Secret 사용 설정한 경우만 입력
KAKAO_CLIENT_SECRET=
NAVER_CLIENT_ID=
NAVER_CLIENT_SECRET=

# 토스페이먼츠 — 자동결제(빌링) 테스트 키는 개발자센터·문서에서 발급·확인
# 서버 전용 (절대 클라이언트 번들에 넣지 말 것)
TOSS_SECRET_KEY=test_sk_zXLkKEypNArWmo50nX3lmeaxYG5R

# 클라이언트 키는 브라우저에 노출되므로 NEXT_PUBLIC_ 접두사 필수 (Next.js App Router)
NEXT_PUBLIC_TOSS_CLIENT_KEY=test_ck_D5GePWvyJnrK0W0k6q8gLzN97Eoq

# 배포 시 고정 도메인이 있으면 설정 (선택, 토스 리다이렉트는 클라이언트에서 origin 사용)
# NEXT_PUBLIC_APP_URL=https://your-production-domain.com

# 체험 한도는 app/lib/trial-access.ts 의 TRIAL_ACCESS_LIMITS_ENABLED 로 켜고 끔.
# (예전) IP 화이트리스트만 쓸 때:
# TRIAL_BYPASS_IPS=203.0.113.10

# 주문연동 — 쿠팡·11번가 등 API 설정 시 사용자가 판매자센터에 등록하는 엑클로드 고정 outbound IP
# NEXT_PUBLIC_EXCLOAD_OUTBOUND_IP=203.0.113.10

# 주문연동 — Access Key / Secret Key / API Key 암호화 저장용 서버 전용 키 (32바이트 random → base64)
# 생성 예: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# EXCLOAD_INTEGRATION_ENCRYPTION_KEY=

# 쿠팡 API 호출 — 고정 IP 프록시 (설정 시 Vercel은 프록시 경유, 미설정 시 direct=관리자 테스트용)
# INTEGRATION_PROXY_BASE_URL=https://coupang-proxy.excload.com
# INTEGRATION_PROXY_SHARED_SECRET=
# INTEGRATION_PROXY_KEY_ID=default
# (하위 호환) COUPANG_PROXY_BASE_URL / COUPANG_PROXY_SHARED_SECRET 도 동일하게 동작

# 주문연동 UI·쿠팡 WING 안내용 — Lightsail Static IP (Vercel IP 아님)
# NEXT_PUBLIC_EXCLOAD_OUTBOUND_IP=

# Shopify OAuth (Partners 앱) — placeholder만, 실제 값 커밋 금지
# Production DB migration·Partners env·UI 활성화 전: false 유지 (기본 비활성)
# SHOPIFY_INTEGRATION_ENABLED=false
# SHOPIFY_CLIENT_ID=
# SHOPIFY_CLIENT_SECRET=
# 선택: state 서명 전용 (미설정 시 EXCLOAD_INTEGRATION_ENCRYPTION_KEY / NEXTAUTH_SECRET fallback)
# SHOPIFY_OAUTH_STATE_SECRET=
# 선택: Partners Allowed redirection URL (미설정 시 https://www.excload.com/api/order/integration/shopify/callback)
# SHOPIFY_OAUTH_REDIRECT_URI=
