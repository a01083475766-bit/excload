# =============================================================================
# .env.smoke.local.example — 주문연동 실테스트 / smoke 전용 env 예시
# =============================================================================
# 사용법:
#   1) 이 파일을 복사해 `.env.smoke.local` 생성 (gitignored)
#   2) 테스트 DB 연결값·암호화 키만 채움
#   3) 쇼핑몰 Access Key / Secret 등은 여기 넣지 않음 → UI에서 저장
#
# 금지:
#   - 운영 Supabase 연결 (운영 project ref — 체크리스트/안전 스크립트 상수 참고)
#   - 이 파일에 실제 secret 값을 채워 Git에 커밋
#   - 기존 운영용 `.env` / `.env.local` 재사용
#
# 안전 점검:
#   node scripts/check-order-sync-realtest-env.mjs
#   npm run order-transmission:test-db:check
# =============================================================================

# --- Env profile (송장전송 mutation preflight 필수) ---
# smoke 전용 파일임을 표시. 다른 값이면 mutation guard 실패.
EXCLOAD_ENV_PROFILE=smoke
# 로드한 파일이 smoke env임을 재확인 (값은 파일명과 일치해야 함)
TEST_DB_ENV_FILE=.env.smoke.local

# --- Test DB mutation switch ---
# 테스트 DB migration / fixture / cleanup 실행을 명시적으로 허용하는 스위치.
# 실제 테스트 DB임을 확인한 뒤에만 true 로 변경하세요.
# 운영·Production 환경에서는 절대 true 로 설정하지 마세요.
# secret은 아니지만 운영(Vercel) 설정에 넣지 마세요.
ALLOW_TEST_DB_MUTATION=false

# --- Database (테스트 DB만) ---
# 기대: D-4 smoke 테스트용 Supabase 프로젝트 (체크리스트의 TEST_REF)
# Session pooler(:5432) 권장. 값 자체는 커밋하지 마세요.
DATABASE_URL=
DIRECT_URL=

# --- NextAuth (로컬) ---
NEXTAUTH_SECRET=
NEXTAUTH_URL=http://localhost:3000

# --- 관리자 (fetch-orders / save / test 는 관리자 세션 필요) ---
# ADMIN_EMAIL 은 로그인할 smoke 사용자 이메일과 다르게 두는 것을 권장
# (동일하면 ADMIN_BCRYPT_HASH 경로가 필요할 수 있음 — D-4 smoke 경험)
ADMIN_EMAIL=
ADMIN_EMAILS=
NEXT_PUBLIC_ADMIN_EMAIL=
ADMIN_BCRYPT_HASH=

# --- 주문연동 자격증명 암호화 (UI save 시 필수) ---
# base64 인코딩된 32바이트 키. 값은 비워 두고 로컬에서만 채움.
# 송장전송 Prisma mutation preflight 에서는 필수가 아님.
EXCLOAD_INTEGRATION_ENCRYPTION_KEY=

# --- 주문 snapshot DB 저장 (실연동 fetch 검증 시 로컬만 true) ---
# 코드는 문자 그대로 'true' 일 때만 ON
ORDER_SYNC_SNAPSHOT_PERSIST_ENABLED=true

# --- 쿠팡 (선택) ---
# 프록시 없이 direct 호출 가능. 실테스트 1순위 권장.
# COUPANG_PROXY_BASE_URL=
# COUPANG_PROXY_SHARED_SECRET=
# COUPANG_PROXY_KEY_ID=default

# --- 스마트스토어 / 범용 통합 프록시 (스마트스토어 실테스트 시 필수) ---
# INTEGRATION_PROXY_BASE_URL=
# INTEGRATION_PROXY_SHARED_SECRET=
# INTEGRATION_PROXY_KEY_ID=default
# NEXT_PUBLIC_EXCLOAD_OUTBOUND_IP=

# --- 쇼핑몰 API 키는 env에 두지 마세요 ---
# 쿠팡: vendorId / accessKey / secretKey → UI 저장
# 스마트스토어: clientId / clientSecret → UI 저장
